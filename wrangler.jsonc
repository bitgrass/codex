{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "test-dapp",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "test-dapp"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CHAT_HISTORY_KV",
      "id": "f4a41af1e7c046e6a29ce329c83eefd6",
      "preview_id": "706723af16b84b28ba10247e9fe78657"
    }
  ],
  "r2_buckets": [],
  "routes": [
    {
      "pattern": "dev.bitgrass.com/*",
      "zone_name": "bitgrass.com"
    }
  ]
}
